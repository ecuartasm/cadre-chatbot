# Cadre AI Support Chatbot — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is committed.
#   cp .env.example .env
#
# Leave values UNQUOTED. python-dotenv strips quotes, but a raw
# `set -a; . ./.env` does not — it would include them in the value.

# --- Anthropic ---
# Server-side only. Never prefix with VITE_ — Vite inlines those into the
# browser bundle at build time, which would publish the key.
ANTHROPIC_API_KEY=sk-ant-...

# Default. 200K ctx, 64K max out, $1/$5 per MTok, 4,096-token cache floor.
# This tier has NO `effort` parameter — that is Claude 5-family only.
#
# Swap to claude-sonnet-5 by changing this line and nothing else; every per-model
# fact lives in app/llm/models.py. Use the switch-model skill, which verifies the
# change actually took effect. Measured head-to-head over the full 71-case suite:
# Haiku wins on cost and first-token latency with no boundary difference.
ANTHROPIC_MODEL=claude-haiku-4-5

# OPTIONAL. Unset (the default) = talk to api.anthropic.com directly, which is
# what local development should do. Set, the client routes through a compatible
# gateway; production uses OpenRouter because the key supplied for the project is
# theirs (sk-or-v1-...) rather than an Anthropic one.
#
# Do NOT include /v1 — the SDK appends /v1/messages itself, so a base ending in
# /v1 makes every request 404 with an HTML body. Correct value:
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api
#
# Note count_tokens does not exist on the gateway, so measuring the system-prompt
# prefix must run against Anthropic directly — leave this unset locally.
# ANTHROPIC_BASE_URL=

# --- Cost guardrails (plan.md Phase 2) ---
# Hard ceiling checked BEFORE the model call, not after. The public URL carries a
# real billed key, so this is a day-one control, not a scaling concern.
DAILY_COST_CAP_USD=5.00
# Per-IP, via a custom key_func reading X-Forwarded-For — slowapi's default reads
# the TCP peer, which behind Railway's router is the router itself.
RATE_LIMIT_PER_MINUTE=20

# --- Logging ---
# On Railway this must point at the mounted volume path, or logs die on redeploy.
LOG_DIR=logs
# Retention is a decision, not a default: the rotation config IS the policy.
LOG_RETENTION_DAYS=7

# --- App ---
ENVIRONMENT=development
# Railway injects PORT at runtime; the app must read it rather than hardcode 8000.
PORT=8000

# Hard stop on how long ONE conversation may run, separate from the 8-turn history bound.
# 0 = UNLIMITED. Read literally, zero would mean "no turns allowed" — a kill switch nobody
# intends — and unlimited is also the behaviour that existed before this setting, so leaving
# it unset changes nothing. Set a positive number to route long conversations to a human.
# NOT an abuse control: a cap that resets on a new conversation cannot stop abuse, since
# starting a new one is free. DAILY_COST_CAP_USD is the control that holds.
MAX_TURNS_PER_CONVERSATION=0
