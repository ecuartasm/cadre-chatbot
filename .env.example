# Cadre AI Support Chatbot — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is committed.
#   cp .env.example .env
#
# Leave values UNQUOTED. python-dotenv strips quotes, but a raw
# `set -a; . ./.env` does not — it would include them in the value.

# --- Anthropic ---
# Server-side only. Never prefix with VITE_ — Vite inlines those into the
# browser bundle at build time, which would publish the key.
ANTHROPIC_API_KEY=sk-ant-...

# Locked decision (CLAUDE.md): 200K ctx, 64K max out, $1/$5 per MTok.
# Note this tier has NO `effort` parameter — that is Claude 5-family only.
# Escalation target if quality gaps appear: claude-sonnet-5 (but it defaults to
# adaptive thinking at effort:high — both must be turned down explicitly).
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Cost guardrails (plan.md Phase 2) ---
# Hard ceiling checked BEFORE the model call, not after. The public URL carries a
# real billed key, so this is a day-one control, not a scaling concern.
DAILY_COST_CAP_USD=5.00
# Per-IP, via a custom key_func reading X-Forwarded-For — slowapi's default reads
# the TCP peer, which behind Railway's router is the router itself.
RATE_LIMIT_PER_MINUTE=20

# --- Logging ---
# On Railway this must point at the mounted volume path, or logs die on redeploy.
LOG_DIR=logs
# Retention is a decision, not a default: the rotation config IS the policy.
LOG_RETENTION_DAYS=7

# --- App ---
ENVIRONMENT=development
# Railway injects PORT at runtime; the app must read it rather than hardcode 8000.
PORT=8000
