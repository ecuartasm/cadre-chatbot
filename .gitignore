# Secrets — must never be committed. The Anthropic key is server-side only.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime logs live on the Railway volume, not in git
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
web/dist/
dist/
.vite/

# Local Claude Code overrides (settings.json IS committed; .local.json is not)
.claude/settings.local.json

# OS
.DS_Store

# Background research, page captures, and the material the client supplied. None of it is part of
# the deliverable, and the supplied material is confidential and not ours to publish. An earlier
# version of this rule excluded the source files one by one while keeping the derived notes tracked;
# the whole directory is excluded now, because the derived notes quote the source closely enough
# that the distinction did not hold.
#
# ⚠️ Ignoring is not purging. Anything committed before a rule like this stays reachable in history
# and must be removed with a history rewrite, which is what was done here.
analysis/

# Corpus backups taken by /update-kb before it overwrites knowledge-base.md. Git is the durable
# history; these are the immediate undo, and they work even when the corpus had uncommitted edits —
# which is exactly when git would not have saved you. Committing copies of a file git already
# versions would just be noise.
content/backups/*
!content/backups/.gitkeep

# Local-only run artifacts (per-model log dirs from eval runs)
.localdata/

# Working notes kept by the author — per-phase narrative, the technical write-up, the model
# comparison. Not part of the deliverable; SPECIFICATION.md is the one document the README points
# at. Same caveat as above: ignoring a directory does nothing about what is already in history.
reports/
