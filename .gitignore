# Secrets — must never be committed. The Anthropic key is server-side only.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime logs live on the Railway volume, not in git
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
web/dist/
dist/
.vite/

# Local Claude Code overrides (settings.json IS committed; .local.json is not)
.claude/settings.local.json

# OS
.DS_Store

# Background research and the material Cadre supplied — the take-home brief, the candidate
# interview guide, raw prompts, page captures, and the derived analysis written from them. None of
# it is part of the deliverable, and the two Cadre PDFs are their confidential hiring material,
# which is not ours to publish. Previously this ignored the source files one by one while keeping
# the derived .md files tracked; the whole directory is now excluded, since the derived documents
# quote the brief closely enough that excluding only the PDFs was a distinction without a
# difference. Untracked with `git rm -r --cached analysis/`.
#
# ⚠️ The versions committed before this point remain reachable in history. This keeps them out of
# the working repo; it is NOT a purge, and it would not protect them if the repo were made public.
# tokens.css and Mockup.jsx cite analysis/brand-tokens-extracted.txt for provenance — those
# comments now point at a local-only file, deliberately.
analysis/

# Corpus backups taken by /update-kb before it overwrites knowledge-base.md. Git is the durable
# history; these are the immediate undo, and they work even when the corpus had uncommitted edits —
# which is exactly when git would not have saved you. Committing copies of a file git already
# versions would just be noise.
content/backups/*
!content/backups/.gitkeep

# Local-only run artifacts (per-model log dirs from eval runs)
.localdata/

# Per-phase narrative reports, the technical report, the model comparison and the review prep.
# Working notes for the author, not part of the deliverable. SPECIFICATION.md is the one document
# the README points at. Untracked with `git rm -r --cached reports/` — note that the versions
# committed before this line remain reachable in history.
reports/
