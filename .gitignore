# Secrets — must never be committed. The Anthropic key is server-side only.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime logs live on the Railway volume, not in git
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
web/dist/
dist/
.vite/

# Local Claude Code overrides (settings.json IS committed; .local.json is not)
.claude/settings.local.json

# OS
.DS_Store

# Personal working notes — raw prompts, not part of the deliverable
analysis/prompt.md
analysis/Cadre_AI_Chatbot_Take_Home_Candidate.docx.pdf
analysis/Cadre_AI_Candidate_Interview_Guide.pdf

# Page captures used as Phase 5 design reference. The 9.5MB PDF is a screenshot, and the saved
# HTML duplicates what content/raw/ already records as the provenance trail. The values actually
# needed are extracted into analysis/brand-tokens-extracted.txt, which IS committed.
analysis/screencapture-*.pdf
analysis/*.html

# Corpus backups taken by /update-kb before it overwrites knowledge-base.md. Git is the durable
# history; these are the immediate undo, and they work even when the corpus had uncommitted edits —
# which is exactly when git would not have saved you. Committing copies of a file git already
# versions would just be noise.
content/backups/*
!content/backups/.gitkeep

# Local-only run artifacts (per-model log dirs from eval runs)
.localdata/
